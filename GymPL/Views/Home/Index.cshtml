<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GeMAWY - Transform Your Body</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <style>
            :root {
                --bg-primary: #0a0a0a;
                --bg-secondary: #0f0f0f;
                --bg-card: #141414;
                --bg-elevated: #1a1a1a;
                --accent-primary: #e63946;
                --accent-secondary: #ff6b6b;
                --text-primary: #ffffff;
                --text-secondary: #b0b0b0;
                --text-muted: #6c757d;
                --border-color: #2a2a2a;
                --gradient-accent: linear-gradient(135deg, #e63946 0%, #ff6b6b 100%);
                --shadow-sm: 0 4px 20px rgba(0, 0, 0, 0.3);
                --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.4);
                --shadow-lg: 0 15px 40px rgba(0, 0, 0, 0.5);
                --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--bg-primary);
                color: var(--text-primary);
                overflow-x: hidden;
                line-height: 1.5;
            }

            /* Custom Scrollbar */
            ::-webkit-scrollbar {
                width: 10px;
            }

            ::-webkit-scrollbar-track {
                background: var(--bg-secondary);
            }

            ::-webkit-scrollbar-thumb {
                background: var(--accent-primary);
                border-radius: 5px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: var(--accent-secondary);
                }

            /* Navigation */
            .navbar {
                background: rgba(10, 10, 10, 0.95);
                backdrop-filter: blur(10px);
                padding: 1rem 0;
                transition: var(--transition);
                border-bottom: 1px solid var(--border-color);
            }

            .navbar-brand {
                font-size: 1.8rem;
                font-weight: 800;
                background: var(--gradient-accent);
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent !important;
                letter-spacing: -0.5px;
            }

            .nav-link {
                color: var(--text-secondary) !important;
                font-weight: 500;
                transition: var(--transition);
                margin: 0 0.5rem;
            }

                .nav-link:hover {
                    color: var(--accent-primary) !important;
                }

            /* Hero Section */
            .hero {
                position: relative;
                height: 100vh;
                min-height: 700px;
                background: linear-gradient(135deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.75) 100%), url('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?ixlib=rb-4.0.3&auto=format&fit=crop&w=1950&q=80');
                background-size: cover;
                background-position: center;
                background-attachment: fixed;
                display: flex;
                align-items: center;
                justify-content: center;
                text-align: center;
                position: relative;
                overflow: hidden;
                margin:85px 0;
            }

                .hero::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    bottom: 0;
                    background: radial-gradient(circle at 30% 50%, rgba(230, 57, 70, 0.15) 0%, transparent 70%);
                }

            .hero-content {
                max-width: 900px;
                padding: 20px;
                animation: fadeInUp 1s ease;
                position: relative;
                z-index: 2;
            }

                .hero-content h1 {
                    font-size: 4.5rem;
                    font-weight: 800;
                    margin-bottom: 20px;
                    text-transform: uppercase;
                    letter-spacing: 3px;
                    line-height: 1.2;
                }

                .hero-content .highlight {
                    background: var(--gradient-accent);
                    -webkit-background-clip: text;
                    background-clip: text;
                    color: transparent;
                }

                .hero-content p {
                    font-size: 1.2rem;
                    margin-bottom: 35px;
                    color: var(--text-secondary);
                    max-width: 600px;
                    margin-left: auto;
                    margin-right: auto;
                }

            .btn-hero {
                background: var(--gradient-accent);
                color: white;
                padding: 14px 35px;
                border-radius: 50px;
                text-decoration: none;
                font-weight: 600;
                font-size: 1rem;
                transition: var(--transition);
                display: inline-block;
                border: none;
                margin: 0 10px;
                letter-spacing: 0.5px;
                box-shadow: 0 4px 15px rgba(230, 57, 70, 0.3);
            }

                .btn-hero:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 8px 25px rgba(230, 57, 70, 0.4);
                    color: white;
                    filter: brightness(1.05);
                }

            .btn-outline-hero {
                background: transparent;
                border: 2px solid var(--accent-primary);
                color: white;
                box-shadow: none;
            }

                .btn-outline-hero:hover {
                    background: var(--accent-primary);
                    transform: translateY(-3px);
                    box-shadow: 0 8px 25px rgba(230, 57, 70, 0.3);
                }

            /* Section Styles */
            section {
                padding: 100px 0;
            }

            .section-title {
                text-align: center;
                margin-bottom: 60px;
            }

                .section-title h2 {
                    font-size: 2.8rem;
                    font-weight: 700;
                    margin-bottom: 15px;
                    letter-spacing: -0.5px;
                }

                .section-title .underline {
                    width: 70px;
                    height: 4px;
                    background: var(--gradient-accent);
                    margin: 0 auto;
                    border-radius: 2px;
                }

            /* Feature Cards */
            .features {
                background: var(--bg-secondary);
            }

            .feature-card {
                background: var(--bg-card);
                padding: 40px 30px;
                text-align: center;
                border-radius: 20px;
                transition: var(--transition);
                border: 1px solid var(--border-color);
                height: 100%;
            }

                .feature-card:hover {
                    transform: translateY(-10px);
                    border-color: var(--accent-primary);
                    box-shadow: var(--shadow-lg);
                }

            .feature-icon {
                width: 80px;
                height: 80px;
                background: var(--gradient-accent);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 25px;
            }

                .feature-icon i {
                    font-size: 2.5rem;
                    color: white;
                }

            .feature-card h3 {
                font-size: 1.5rem;
                font-weight: 600;
                margin-bottom: 15px;
            }

            .feature-card p {
                color: var(--text-secondary);
                line-height: 1.6;
            }

            /* About Section */
            .about {
                background: var(--bg-primary);
            }

            .about-image {
                border-radius: 20px;
                overflow: hidden;
                box-shadow: var(--shadow-md);
                border: 1px solid var(--border-color);
            }

                .about-image img {
                    width: 100%;
                    height: auto;
                    transition: transform 0.5s ease;
                }

                .about-image:hover img {
                    transform: scale(1.05);
                }

            .about-content h2 {
                font-size: 2.5rem;
                font-weight: 700;
                margin-bottom: 20px;
            }

            .about-content p {
                color: var(--text-secondary);
                line-height: 1.8;
                margin-bottom: 20px;
            }

            .stats {
                display: flex;
                gap: 40px;
                margin-top: 30px;
                flex-wrap: wrap;
            }

            .stat-item {
                text-align: center;
            }

            .stat-number {
                font-size: 2.2rem;
                font-weight: 800;
                background: var(--gradient-accent);
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
            }

            .stat-label {
                color: var(--text-secondary);
                font-weight: 500;
                font-size: 0.9rem;
            }

            /* Classes Section */
            .classes {
                background: var(--bg-secondary);
            }

            .class-card {
                background: var(--bg-card);
                border-radius: 20px;
                overflow: hidden;
                transition: var(--transition);
                border: 1px solid var(--border-color);
                height: 100%;
            }

                .class-card:hover {
                    transform: translateY(-10px);
                    border-color: var(--accent-primary);
                    box-shadow: var(--shadow-lg);
                }

            .class-image {
                height: 250px;
                overflow: hidden;
            }

                .class-image img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    transition: transform 0.5s ease;
                }

            .class-card:hover .class-image img {
                transform: scale(1.1);
            }

            .class-info {
                padding: 25px;
            }

                .class-info h3 {
                    font-size: 1.3rem;
                    font-weight: 600;
                    margin-bottom: 10px;
                }

            .class-meta {
                display: flex;
                justify-content: space-between;
                margin: 15px 0;
                color: var(--accent-primary);
                font-weight: 600;
                font-size: 0.9rem;
            }

            /* Pricing Section */
            .pricing {
                background: linear-gradient(135deg, #0a0a0a 0%, #0f0f0f 100%);
                position: relative;
            }

                .pricing::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    bottom: 0;
                    background: radial-gradient(circle at 70% 30%, rgba(230, 57, 70, 0.08) 0%, transparent 70%);
                }

            .pricing-card {
                background: var(--bg-card);
                border-radius: 20px;
                overflow: hidden;
                transition: var(--transition);
                border: 1px solid var(--border-color);
                position: relative;
                height: 100%;
            }

                .pricing-card:hover {
                    transform: translateY(-10px);
                    border-color: var(--accent-primary);
                    box-shadow: var(--shadow-lg);
                }

            .pricing-header {
                background: var(--gradient-accent);
                padding: 30px;
                text-align: center;
            }

                .pricing-header h3 {
                    font-size: 1.8rem;
                    font-weight: 700;
                    margin-bottom: 10px;
                }

            .price {
                font-size: 3rem;
                font-weight: 800;
            }

                .price span {
                    font-size: 1rem;
                    font-weight: 400;
                }

            .pricing-body {
                padding: 30px;
            }

                .pricing-body ul {
                    list-style: none;
                    padding: 0;
                    margin-bottom: 25px;
                }

                .pricing-body li {
                    padding: 12px 0;
                    border-bottom: 1px solid var(--border-color);
                    color: var(--text-secondary);
                }

                    .pricing-body li i {
                        color: var(--accent-primary);
                        margin-right: 10px;
                    }

                    .pricing-body li .fa-times {
                        color: var(--text-muted);
                    }

            /* Contact Section */
            .contact {
                background: var(--bg-secondary);
            }

            .contact-info {
                background: var(--gradient-accent);
                padding: 40px;
                border-radius: 20px;
                height: 100%;
                box-shadow: var(--shadow-md);
            }

                .contact-info h3 {
                    margin-bottom: 30px;
                    font-weight: 700;
                }

            .contact-item {
                display: flex;
                align-items: center;
                gap: 15px;
                margin-bottom: 25px;
            }

                .contact-item i {
                    font-size: 1.5rem;
                    width: 30px;
                }

            .contact-form {
                background: var(--bg-card);
                padding: 40px;
                border-radius: 20px;
                border: 1px solid var(--border-color);
                height: 100%;
            }

                .contact-form h3 {
                    margin-bottom: 30px;
                    font-weight: 700;
                }

            .form-control {
                background: var(--bg-elevated);
                border: 1px solid var(--border-color);
                color: var(--text-primary);
                padding: 12px 15px;
                border-radius: 12px;
                transition: var(--transition);
            }

                .form-control:focus {
                    background: var(--bg-elevated);
                    border-color: var(--accent-primary);
                    color: var(--text-primary);
                    box-shadow: 0 0 0 3px rgba(230, 57, 70, 0.1);
                }

                .form-control::placeholder {
                    color: var(--text-muted);
                }

            /* Footer */
            footer {
                background: var(--bg-primary);
                border-top: 1px solid var(--border-color);
                padding: 60px 0 30px;
            }

            .footer-links h4 {
                margin-bottom: 20px;
                font-weight: 600;
            }

            .footer-links ul {
                list-style: none;
                padding: 0;
            }

            .footer-links li {
                margin-bottom: 12px;
            }

            .footer-links a {
                color: var(--text-secondary);
                text-decoration: none;
                transition: var(--transition);
            }

                .footer-links a:hover {
                    color: var(--accent-primary);
                }

            .social-links {
                display: flex;
                gap: 12px;
                margin-top: 20px;
            }

                .social-links a {
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    width: 38px;
                    height: 38px;
                    background: var(--bg-card);
                    border-radius: 50%;
                    transition: var(--transition);
                    border: 1px solid var(--border-color);
                    color: var(--text-secondary);
                }

                    .social-links a:hover {
                        background: var(--accent-primary);
                        color: white;
                        transform: translateY(-3px);
                    }

            .copyright {
                text-align: center;
                padding-top: 40px;
                margin-top: 40px;
                border-top: 1px solid var(--border-color);
                color: var(--text-muted);
                font-size: 0.9rem;
            }

            /* Animations */
            keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* Responsive */
            media (max-width: 768px) {
                .hero-content h1 {
                    font-size: 2.5rem;
                }

                .section-title h2 {
                    font-size: 2rem;
                }

                section {
                    padding: 60px 0;
                }

                .stats {
                    gap: 20px;
                }

                .contact-info, .contact-form {
                    margin-bottom: 20px;
                }

            }


            /* Join Us Button */
            .btn-join-us {
                background: var(--gradient-accent);
                color: white;
                padding: 8px 22px;
                border-radius: 50px;
                font-weight: 600;
                font-size: 0.9rem;
                transition: var(--transition);
                display: inline-block;
                text-decoration: none;
                border: none;
                margin-left: 10px;
            }

                .btn-join-us:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 25px rgba(230, 57, 70, 0.4);
                    color: white;
                }

                .btn-join-us i {
                    margin-right: 6px;
                }

            /* Responsive */
@@media (max-width: 991px) {
                .btn-join-us {
                    margin-top: 10px;
                    text-align: center;
                    display: inline-block;
                    width: auto;
                }

                .navbar-nav .nav-item {
                    text-align: center;
                }
            }
    </style>
</head>
<body>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="navbar-brand" href="#">GyMAWY </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    @if (!User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item"><a class="nav-link" href="#home">Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="#pricing">Pricing</a></li>
                        <li class="nav-item ms-lg-2">
                            <a class="btn-join-us" asp-action="Register" asp-controller="Auth" asp-route-mode="register">
                                <i class="fas fa-user-plus"></i> Join Us
                            </a>
                        </li>
                    }
                     @if (User.Identity.IsAuthenticated)
                {
                    <li class="nav-item"><a class="nav-link" href="#home">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="#pricing">Pricing</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Gym")">Members</a></li>
                    <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
                        <li>
                            <form asp-action="Logout" asp-controller="Auth" method="post" id="logoutForm">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger">
                                    Logout
                                </button>
                            </form>
                        </li>
                        }
                    </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="hero-content">
            <h1>TRANSFORM YOUR <span class="highlight">BODY</span></h1>
            <h1>UNLOCK YOUR <span class="highlight">POTENTIAL</span></h1>
            <p>Join GeMAWY today and start your journey to a healthier, stronger, and more confident you.</p>
            <a asp-controller="Gym" asp-action="AddMember" class="btn-hero">
                <i class="fas fa-user-plus"></i> Join Now
            </a>
            <a asp-controller="Trainer" asp-action="Index" class="btn-hero btn-outline-hero">
                <i class="fas fa-users"></i> Our Trainers
            </a>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features">
        <div class="container">
            <div class="section-title">
                <h2>Why Choose Us</h2>
                <div class="underline"></div>
            </div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-dumbbell"></i>
                        </div>
                        <h3>Modern Equipment</h3>
                        <p>State-of-the-art fitness equipment from top brands for the best workout experience.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-chalkboard-user"></i>
                        </div>
                        <h3>Expert Trainers</h3>
                        <p>Certified professional trainers to guide you and help achieve your fitness goals.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-clock"></i>
                        </div>
                        <h3>24/7 Access</h3>
                        <p>Workout anytime that fits your schedule with our round-the-clock access.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>





    <!-- Pricing Section -->
    <section id="pricing" class="pricing">
        <div class="container">
            <div class="section-title">
                <h2 style="color: white;">Membership Plans</h2>
                <div class="underline"></div>
            </div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="pricing-card">
                        <div class="pricing-header">
                            <h3>Basic Plan</h3>
                            <div class="price">$49<span>/month</span></div>
                        </div>
                        <div class="pricing-body">
                            <ul>
                                <li><i class="fas fa-check"></i> Gym Access (9 AM - 9 PM)</li>
                                <li><i class="fas fa-check"></i> 2 Group Classes</li>
                                <li><i class="fas fa-check"></i> Locker Room Access</li>
                                <li><i class="fas fa-times"></i> Personal Training</li>
                                <li><i class="fas fa-times"></i> Nutrition Plan</li>
                            </ul>
                            <a asp-controller="Member" asp-action="AddMember" class="btn-hero" style="width: 100%; text-align: center;">Get Started</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="pricing-card">
                        <div class="pricing-header">
                            <h3>Premium Plan</h3>
                            <div class="price">$89<span>/month</span></div>
                        </div>
                        <div class="pricing-body">
                            <ul>
                                <li><i class="fas fa-check"></i> 24/7 Gym Access</li>
                                <li><i class="fas fa-check"></i> Unlimited Group Classes</li>
                                <li><i class="fas fa-check"></i> Locker Room + Sauna</li>
                                <li><i class="fas fa-check"></i> 2 Personal Training Sessions</li>
                                <li><i class="fas fa-times"></i> Nutrition Plan</li>
                            </ul>
                            <a asp-controller="Member" asp-action="AddMember" class="btn-hero" style="width: 100%; text-align: center;">Get Started</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="pricing-card">
                        <div class="pricing-header">
                            <h3>Elite Plan</h3>
                            <div class="price">$149<span>/month</span></div>
                        </div>
                        <div class="pricing-body">
                            <ul>
                                <li><i class="fas fa-check"></i> 24/7 Gym Access</li>
                                <li><i class="fas fa-check"></i> Unlimited Group Classes</li>
                                <li><i class="fas fa-check"></i> Premium Amenities</li>
                                <li><i class="fas fa-check"></i> Weekly Personal Training</li>
                                <li><i class="fas fa-check"></i> Custom Nutrition Plan</li>
                            </ul>
                            <a asp-controller="Member" asp-action="AddMember" class="btn-hero" style="width: 100%; text-align: center;">Get Started</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-5">
                    <div class="contact-info">
                        <h3>Visit Us Today!</h3>
                        <div class="contact-item">
                            <i class="fas fa-map-marker-alt"></i>
                            <div>123 Fitness Street, Downtown, Cairo, Egypt</div>
                        </div>
                        <div class="contact-item">
                            <i class="fas fa-phone"></i>
                            <div>+20 123 456 7890</div>
                        </div>
                        <div class="contact-item">
                            <i class="fas fa-envelope"></i>
                            <div>info@elitegym.com</div>
                        </div>
                        <div class="contact-item">
                            <i class="fas fa-clock"></i>
                            <div>Open 24/7 - Always Here For You</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="contact-form">
                        <h3>Send Us a Message</h3>
                        <form>
                            <div class="mb-3">
                                <input type="text" class="form-control" placeholder="Your Name">
                            </div>
                            <div class="mb-3">
                                <input type="email" class="form-control" placeholder="Your Email">
                            </div>
                            <div class="mb-3">
                                <textarea class="form-control" rows="5" placeholder="Your Message"></textarea>
                            </div>
                            <button type="submit" class="btn-hero">Send Message</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

