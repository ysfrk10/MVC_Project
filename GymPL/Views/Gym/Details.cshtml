@using GymBL.DTOS
@model GetDTO

@{
    ViewBag.Title = "Member Details";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light d-flex align-items-center" style="min-height: 100vh;">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                
                <!-- Card -->
                <div class="card shadow-lg border-0 rounded-4">
                    <div class="card-body p-4 p-md-5 text-center">
                        
                        <!-- Header -->
                        <h3 class="card-title text-primary mb-4">Member Details</h3>
                        
                        <!-- Member Info -->
                        <div class="text-start mb-4">
                        
                            
                            <div class="mb-3">
                                <label class="fw-bold text-muted small">Name</label>
                                <div class="p-2 bg-light rounded">@Model.Name</div>
                            </div>
                            
                            <div class="mb-3">
                                <label class="fw-bold text-muted small">JoinDate</label>
                                <div class="p-2 bg-light rounded">@Model.JoinDate</div>
                            </div>
                            
                            <div class="mb-3">
                                <label class="fw-bold text-muted small">Phone</label>
                                <div class="p-2 bg-light rounded">@Model.PhoneNumber</div>
                            </div>
                            
                            <!-- Trainer Section with Null Check -->
                            @* <div class="mb-3">
                                <label class="fw-bold text-muted small">Trainer</label>
                                <div class="p-2 rounded @(Model.trainer != null ? "bg-info bg-opacity-10" : "bg-light")">
                                    @if (Model.trainer != null)
                                    {
                                        <span>@Model.trainer</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">No trainer assigned</span>
                                    }
                                </div> *@
                            </div>
                        </div>
                        
                        <!-- Back Button -->
                        <a href="@Url.Action("Index", "Gym")" class="btn btn-primary px-4">
                            ← Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>