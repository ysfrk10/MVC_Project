@using GymPL.ViewModel
@model AddVm

@{
    ViewData["Title"] = "Add New Member";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Elite Gym</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
            :root {
                --bg-primary: #0a0a0a;
                --bg-secondary: #0f0f0f;
                --bg-card: #141414;
                --bg-elevated: #1a1a1a;
                --accent-primary: #e63946;
                --accent-secondary: #ff6b6b;
                --text-primary: #ffffff;
                --text-secondary: #b0b0b0;
                --text-muted: #6c757d;
                --border-color: #2a2a2a;
                --gradient-accent: linear-gradient(135deg, #e63946 0%, #ff6b6b 100%);
                --shadow-sm: 0 4px 20px rgba(0, 0, 0, 0.3);
                --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.4);
                --shadow-lg: 0 15px 40px rgba(0, 0, 0, 0.5);
                --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', sans-serif;
                min-height: 100vh;
                background: var(--bg-primary);
                position: relative;
            }

                /* Animated Background */
                body::before {
                    content: '';
                    position: fixed;
                    top: 0;
                    left: 0;
                    right: 0;
                    bottom: 0;
                    background: radial-gradient(circle at 20% 50%, rgba(230, 57, 70, 0.08) 0%, transparent 50%), radial-gradient(circle at 80% 80%, rgba(255, 107, 107, 0.05) 0%, transparent 50%);
                    z-index: -1;
                }

            /* Navigation */
            .navbar {
                background: rgba(10, 10, 10, 0.95);
                backdrop-filter: blur(10px);
                padding: 1rem 0;
                border-bottom: 1px solid var(--border-color);
            }

            .navbar-brand {
                font-size: 1.8rem;
                font-weight: 800;
                background: var(--gradient-accent);
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent !important;
                letter-spacing: -0.5px;
            }

            .nav-link {
                color: var(--text-secondary) !important;
                font-weight: 500;
                transition: var(--transition);
                margin: 0 0.5rem;
            }

                .nav-link:hover {
                    color: var(--accent-primary) !important;
                }

            /* Main Card */
            .register-container {
                min-height: calc(100vh - 200px);
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px 20px;
            }

            .register-card {
                max-width: 550px;
                width: 100%;
                background: var(--bg-card);
                border-radius: 24px;
                box-shadow: var(--shadow-lg);
                overflow: hidden;
                border: 1px solid var(--border-color);
                animation: slideUp 0.5s ease;
            }

            @@keyframes slideUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* Card Header */
            .card-header {
                background: linear-gradient(135deg, rgba(230, 57, 70, 0.15) 0%, rgba(255, 107, 107, 0.05) 100%);
                padding: 30px;
                text-align: center;
                border-bottom: 1px solid var(--border-color);
            }

                .card-header i {
                    font-size: 48px;
                    background: var(--gradient-accent);
                    -webkit-background-clip: text;
                    background-clip: text;
                    color: transparent;
                    margin-bottom: 10px;
                }

                .card-header h2 {
                    margin: 0;
                    font-size: 1.8rem;
                    font-weight: 700;
                    color: var(--text-primary);
                }

                .card-header p {
                    margin: 8px 0 0;
                    color: var(--text-secondary);
                    font-size: 0.9rem;
                }

            /* Toggle Switch */
            .toggle-container {
                background: var(--bg-elevated);
                padding: 8px;
                border-radius: 60px;
                margin: 20px 30px 0;
                border: 1px solid var(--border-color);
            }

            .toggle-switch {
                display: flex;
                gap: 8px;
            }

            .toggle-option {
                flex: 1;
                text-align: center;
                padding: 12px 20px;
                border-radius: 50px;
                font-weight: 600;
                cursor: pointer;
                transition: var(--transition);
                background: transparent;
                color: var(--text-secondary);
                border: none;
                font-size: 1rem;
            }

                .toggle-option i {
                    margin-right: 8px;
                }

                .toggle-option.active {
                    background: var(--gradient-accent);
                    color: white;
                    box-shadow: var(--shadow-sm);
                }

                .toggle-option:not(.active):hover {
                    background: rgba(230, 57, 70, 0.1);
                    color: var(--text-primary);
                }

            /* Card Body */
            .card-body {
                padding: 30px;
            }

            /* Form Groups */
            .form-group {
                margin-bottom: 24px;
            }

                .form-group label {
                    font-weight: 600;
                    color: var(--text-primary);
                    margin-bottom: 8px;
                    display: block;
                    font-size: 0.9rem;
                }

                    .form-group label i {
                        color: var(--accent-primary);
                        margin-right: 8px;
                    }

            .required:after {
                content: '*';
                color: var(--accent-primary);
                margin-left: 4px;
            }

            .form-control, .form-select {
                width: 100%;
                padding: 12px 16px;
                background: var(--bg-elevated);
                border: 1px solid var(--border-color);
                border-radius: 12px;
                font-size: 0.95rem;
                color: var(--text-primary);
                transition: var(--transition);
            }

                .form-control:focus, .form-select:focus {
                    border-color: var(--accent-primary);
                    outline: none;
                    box-shadow: 0 0 0 3px rgba(230, 57, 70, 0.15);
                    background: var(--bg-elevated);
                    color: var(--text-primary);
                }

                .form-control::placeholder {
                    color: var(--text-muted);
                }

            /* Textarea */
            textarea.form-control {
                resize: vertical;
                min-height: 80px;
            }

            /* Validation */
            .text-danger {
                color: var(--accent-primary);
                font-size: 0.75rem;
                margin-top: 5px;
                display: block;
            }

            /* Alert */
            .alert-success {
                background: rgba(40, 167, 69, 0.15);
                border: 1px solid rgba(40, 167, 69, 0.3);
                border-radius: 12px;
                padding: 12px 16px;
                margin-bottom: 20px;
                color: #28a745;
            }

                .alert-success i {
                    margin-right: 8px;
                }

            /* Submit Button */
            .btn-register {
                width: 100%;
                padding: 14px;
                background: var(--gradient-accent);
                color: white;
                border: none;
                border-radius: 50px;
                font-size: 1rem;
                font-weight: 600;
                cursor: pointer;
                transition: var(--transition);
                margin-top: 10px;
            }

                .btn-register:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 25px rgba(230, 57, 70, 0.4);
                }

                .btn-register:active {
                    transform: translateY(0);
                }

            /* Trainer Fields (hidden by default) */
            .trainer-fields {
                display: none;
            }

            /* Footer */
            footer {
                background: var(--bg-primary);
                border-top: 1px solid var(--border-color);
                padding: 30px 0 20px;
                margin-top: 60px;
            }

            .footer-content {
                text-align: center;
                color: var(--text-muted);
                font-size: 0.85rem;
            }

                .footer-content a {
                    color: var(--accent-primary);
                    text-decoration: none;
                }

            /* Responsive */
            @@media (max-width: 768px) {
                .register-container {
                    padding: 20px 16px;
                }

                .card-header {
                    padding: 25px 20px;
                }

                .card-body {
                    padding: 25px 20px;
                }

                .toggle-option {
                    padding: 10px 16px;
                    font-size: 0.9rem;
                }
            }

            /* Custom Select Styling */
            select.form-select option {
                background: var(--bg-elevated);
                color: var(--text-primary);
            }
    </style>
</head>
<body>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/">GyMAWY</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Trainer")">Trainers</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#pricing">Pricing</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("ViewAllMembers", "Gym")">Members</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#contact">Contact</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Register Container -->
    <div class="register-container">
        <div class="register-card">
            <div class="card-header">
                <i class="fas fa-dumbbell"></i>
                <h2 id="formTitle">Register New Member</h2>
                <p id="formSubtitle">Join our fitness family 💪</p>
            </div>

            <!-- Professional Toggle -->
            <div class="toggle-container">
                <div class="toggle-switch">
                    <button type="button" class="toggle-option active" data-type="member" id="memberToggle">
                        <i class="fas fa-user-plus"></i> Add Member
                    </button>
                    <button type="button" class="toggle-option" data-type="trainer" id="trainerToggle">
                        <i class="fas fa-chalkboard-user"></i> Add Trainer
                    </button>
                </div>
            </div>

            <div class="card-body">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert-success">
                        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                    </div>
                }

                <!-- Member Form -->
                <form id="memberForm" asp-action="AddMember" asp-controller="Gym" method="post" style="display: block;">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label class="required"><i class="fas fa-user"></i> Full Name</label>
                        <input asp-for="@Model.Name" class="form-control" placeholder="Enter full name..." autocomplete="off" />
                        <span asp-validation-for="@Model.Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label class="required"><i class="fas fa-phone-alt"></i> Phone Number</label>
                        <input asp-for="@Model.PhoneNumber" class="form-control" placeholder="ex: 01234567890" />
                        <span asp-validation-for="@Model.PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label class="required"><i class="fas fa-calendar-alt"></i> Join Date</label>
                        <input asp-for="@Model.JoinDate" type="date" class="form-control" />
                        <span asp-validation-for="@Model.JoinDate" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn-register">
                        <i class="fas fa-user-plus"></i> Register Member
                    </button>
                </form>

                <!-- Trainer Form -->
                <form id="trainerForm" asp-action="AddTrainer" asp-controller="Trainer" method="post" style="display: none;">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label class="required"><i class="fas fa-user"></i> Full Name</label>
                        <input name="Name" class="form-control" placeholder="Enter trainer name..." autocomplete="off" />
                    </div>

                    <div class="form-group">
                        <label class="required"><i class="fas fa-phone-alt"></i> Phone Number</label>
                        <input name="PhoneNumber" class="form-control" placeholder="ex: 01234567890" />
                    </div>

                    @* <div class="form-group">
                        <label class="required"><i class="fas fa-certificate"></i> Specialization</label>
                        <select name="Specialization" class="form-select">
                            <option value="">Select Specialization</option>
                            <option value="Personal Trainer">Personal Trainer</option>
                            <option value="Yoga Instructor">Yoga Instructor</option>
                            <option value="HIIT Coach">HIIT Coach</option>
                            <option value="Bodybuilding Coach">Bodybuilding Coach</option>
                            <option value="Nutritionist">Nutritionist</option>
                            <option value="CrossFit Trainer">CrossFit Trainer</option>
                        </select>
                    </div> *@

                  @*   <div class="form-group">
                        <label><i class="fas fa-briefcase"></i> Experience (Years)</label>
                        <input name="Experience" type="number" class="form-control" placeholder="Years of experience" />
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-align-left"></i> Bio</label>
                        <textarea name="Bio" class="form-control" placeholder="Short bio about the trainer..."></textarea>
                    </div> *@

                    <div class="form-group">
                        <label><i class="fas fa-user"></i> Image Link</label>
                        <input  type="text" class="form-control" placeholder="Enter Image Link" />
                    </div>

                    <button type="submit" class="btn-register">
                        <i class="fas fa-chalkboard-user"></i> Register Trainer
                    </button>
                </form>
            </div>
        </div>
    </div>

  

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        // Set default join date to today for member form
        document.addEventListener('DOMContentLoaded', function() {
        const joinDateInput = document.querySelector('#memberForm input[name="JoinDate"]');
        if (joinDateInput && !joinDateInput.value) {
        const today = new Date().toISOString().split('T')[0];
        joinDateInput.value = today;
        }
        });

        // Toggle between Member and Trainer forms
        const memberToggle = document.getElementById('memberToggle');
        const trainerToggle = document.getElementById('trainerToggle');
        const memberForm = document.getElementById('memberForm');
        const trainerForm = document.getElementById('trainerForm');
        const formTitle = document.getElementById('formTitle');
        const formSubtitle = document.getElementById('formSubtitle');

        function setActiveToggle(active) {
        if (active === 'member') {
        memberToggle.classList.add('active');
        trainerToggle.classList.remove('active');
        memberForm.style.display = 'block';
        trainerForm.style.display = 'none';
        formTitle.textContent = 'Register New Member';
        formSubtitle.textContent = 'Join our fitness family 💪';
        } else {
        memberToggle.classList.remove('active');
        trainerToggle.classList.add('active');
        memberForm.style.display = 'none';
        trainerForm.style.display = 'block';
        formTitle.textContent = 'Register New Trainer';
        formSubtitle.textContent = 'Join our expert team 🏆';
        }
        }

        memberToggle.addEventListener('click', () => setActiveToggle('member'));
        trainerToggle.addEventListener('click', () => setActiveToggle('trainer'));

        // Optional: Handle URL parameter to pre-select trainer form
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('type') === 'trainer') {
        setActiveToggle('trainer');
        }
    </script>

    <!-- Validation Scripts for Trainer Form -->
    <script>
        // Basic validation for trainer form
        const trainerFormElement = document.getElementById('trainerForm');
        if (trainerFormElement) {
        trainerFormElement.addEventListener('submit', function(e) {
        const name = this.querySelector('input[name="Name"]').value.trim();
        const phone = this.querySelector('input[name="PhoneNumber"]').value.trim();

        if (!name) {
        e.preventDefault();
        alert('Please enter trainer name');
        } else if (!phone) {
        e.preventDefault();
        alert('Please enter phone number');
        }
        });
        }
    </script>
</body>
</html>