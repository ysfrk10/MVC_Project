@using GymBL.DTOS
@using GymDAL.Entities
@model IEnumerable<GetDTO>

@{
    ViewData["Title"] = "All Members";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Elite Gym</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <style>
            :root {
                --bg-primary: #0a0a0a;
                --bg-secondary: #0f0f0f;
                --bg-card: #141414;
                --bg-elevated: #1a1a1a;
                --accent-primary: #e63946;
                --accent-secondary: #ff6b6b;
                --text-primary: #ffffff;
                --text-secondary: #b0b0b0;
                --text-muted: #6c757d;
                --border-color: #2a2a2a;
                --gradient-accent: linear-gradient(135deg, #e63946 0%, #ff6b6b 100%);
                --shadow-sm: 0 4px 20px rgba(0, 0, 0, 0.3);
                --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.4);
                --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--bg-primary);
                color: var(--text-primary);
                overflow-x: hidden;
                line-height: 1.5;
            }

            /* Custom Scrollbar */
            ::-webkit-scrollbar {
                width: 10px;
            }

            ::-webkit-scrollbar-track {
                background: var(--bg-secondary);
            }

            ::-webkit-scrollbar-thumb {
                background: var(--accent-primary);
                border-radius: 5px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: var(--accent-secondary);
                }

            /* Navigation - Matching Home Page */
            .navbar {
                background: rgba(10, 10, 10, 0.95);
                backdrop-filter: blur(10px);
                padding: 1rem 0;
                transition: var(--transition);
                border-bottom: 1px solid var(--border-color);
            }

            .navbar-brand {
                font-size: 1.8rem;
                font-weight: 800;
                background: var(--gradient-accent);
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent !important;
                letter-spacing: -0.5px;
            }

            .nav-link {
                color: var(--text-secondary) !important;
                font-weight: 500;
                transition: var(--transition);
                margin: 0 0.5rem;
            }

                .nav-link:hover {
                    color: var(--accent-primary) !important;
                }

            /* Main Content Container */
            .members-container {
                min-height: calc(100vh - 200px);
                padding: 40px 0;
                margin:80px 0;
            }

            .members-card {
                background: var(--bg-card);
                border-radius: 20px;
                border: 1px solid var(--border-color);
                overflow: hidden;
                box-shadow: var(--shadow-sm);
            }

            .card-header-custom {
                background: linear-gradient(135deg, rgba(230, 57, 70, 0.15) 0%, rgba(255, 107, 107, 0.05) 100%);
                padding: 25px 30px;
                border-bottom: 1px solid var(--border-color);
            }

                .card-header-custom h2 {
                    font-size: 1.8rem;
                    font-weight: 700;
                    margin: 0;
                    display: flex;
                    align-items: center;
                    gap: 12px;
                }

                    .card-header-custom h2 i {
                        color: var(--accent-primary);
                        font-size: 1.8rem;
                    }

            .badge-count {
                background: var(--accent-primary);
                color: white;
                border-radius: 50px;
                padding: 4px 12px;
                font-size: 0.9rem;
                font-weight: 600;
                margin-left: 12px;
            }

            /* Table Styling */
            .table-custom {
                margin-bottom: 0;
            }

                .table-custom thead th {
                    background: var(--bg-elevated);
                    color: var(--text-primary);
                    font-weight: 600;
                    border-bottom: 2px solid var(--accent-primary);
                    padding: 15px;
                    font-size: 0.9rem;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                }

                .table-custom tbody td {
                    padding: 15px;
                    vertical-align: middle;
                    border-bottom: 1px solid var(--border-color);
                    color: var(--text-secondary);
                }

                .table-custom tbody tr {
                    transition: var(--transition);
                }

                    .table-custom tbody tr:hover {
                        background: rgba(230, 57, 70, 0.05);
                    }

                        .table-custom tbody tr:hover td {
                            color: var(--text-primary);
                        }

            /* Button Styles */
            .btn-custom {
                padding: 6px 14px;
                border-radius: 8px;
                font-size: 0.8rem;
                font-weight: 500;
                transition: var(--transition);
                margin: 0 3px;
            }

            .btn-info-custom {
                background: rgba(13, 202, 240, 0.15);
                color: #0dcaf0;
                border: 1px solid rgba(13, 202, 240, 0.3);
            }

                .btn-info-custom:hover {
                    background: #0dcaf0;
                    color: var(--bg-primary);
                    transform: translateY(-2px);
                }

            .btn-warning-custom {
                background: rgba(255, 193, 7, 0.15);
                color: #ffc107;
                border: 1px solid rgba(255, 193, 7, 0.3);
            }

                .btn-warning-custom:hover {
                    background: #ffc107;
                    color: var(--bg-primary);
                    transform: translateY(-2px);
                }

            .btn-danger-custom {
                background: rgba(230, 57, 70, 0.15);
                color: var(--accent-primary);
                border: 1px solid rgba(230, 57, 70, 0.3);
            }

                .btn-danger-custom:hover {
                    background: var(--accent-primary);
                    color: white;
                    transform: translateY(-2px);
                }

            .btn-success-custom {
                background: var(--gradient-accent);
                color: white;
                border: none;
                padding: 12px 32px;
                border-radius: 50px;
                font-weight: 600;
                transition: var(--transition);
                box-shadow: 0 4px 15px rgba(230, 57, 70, 0.3);
            }

                .btn-success-custom:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 25px rgba(230, 57, 70, 0.4);
                    color: white;
                }

            /* Alert Styling */
            .alert-custom {
                background: var(--bg-elevated);
                border: 1px solid var(--border-color);
                border-radius: 12px;
                padding: 20px;
                text-align: center;
            }

                .alert-custom i {
                    font-size: 3rem;
                    color: var(--accent-primary);
                    margin-bottom: 15px;
                    display: block;
                }

                .alert-custom p {
                    color: var(--text-secondary);
                    margin: 0;
                }

            /* Footer */
            footer {
                background: var(--bg-primary);
                border-top: 1px solid var(--border-color);
                padding: 40px 0 20px;
                margin-top: 60px;
            }

            .footer-content {
                text-align: center;
                color: var(--text-muted);
                font-size: 0.9rem;
            }

                .footer-content a {
                    color: var(--accent-primary);
                    text-decoration: none;
                }

                    .footer-content a:hover {
                        text-decoration: underline;
                    }

            /* Responsive */
            media (max-width: 768px) {
                .members-container {
                    padding: 20px 0;
                }

                .card-header-custom {
                    padding: 18px 20px;
                }

                    .card-header-custom h2 {
                        font-size: 1.4rem;
                    }

                .table-custom thead th,
                .table-custom tbody td {
                    padding: 10px;
                    font-size: 0.8rem;
                }

                .btn-custom {
                    padding: 4px 10px;
                    font-size: 0.7rem;
                    margin: 2px;
                }

                .btn-success-custom {
                    padding: 10px 24px;
                }
            }

            /* Animation */
            keyframes fadeIn {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .members-card {
                animation: fadeIn 0.5s ease;
            }
    </style>
</head>
<body>
    <!-- Main Content -->
    <div class="members-container">
        <div class="container">
            <div class="members-card">
                <div class="card-header-custom">
                    <h2>
                        <i class="fas fa-users"></i>
                        Members List
                        @if (Model != null && Model.Any())
                        {
                            <span class="badge-count">@Model.Count() total</span>
                        }
                    </h2>
                </div>

                <div class="p-0">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-custom">
                                <thead>
                                    <tr>
                                        <th><i class="fas fa-user me-2"></i>Name</th>
                                        <th><i class="fas fa-phone me-2"></i>Phone</th>
                                        <th><i class="fas fa-calendar-alt me-2"></i>Registration Date</th>
                                        <th><i class="fas fa-cog me-2"></i>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var member in Model)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="avatar-placeholder" style="width: 32px; height: 32px; background: var(--gradient-accent); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;">
                                                        <i class="fas fa-user" style="font-size: 14px;"></i>
                                                    </div>
                                                    <strong style="color: var(--text-primary);">@member.Name</strong>
                                                </div>
                                            </td>
                                            <td>@member.PhoneNumber</td>
                                            <td>@member.JoinDate.ToShortDateString()</td>
                                            <td>
                                                <a href="@Url.Action("Details", "Gym", new { id = member.Id })" class="btn btn-custom btn-info-custom">
                                                    <i class="fas fa-eye"></i> Details
                                                </a>
                                                <a href="@Url.Action("EditMember", "Gym", new { id = member.Id })" class="btn btn-custom btn-warning-custom">
                                                    <i class="fas fa-edit"></i> Edit
                                                </a>
                                                <a href="@Url.Action("RemoveMember", "Gym", new { id = member.Id })" class="btn btn-custom btn-danger-custom" onclick="return confirm('Are you sure you want to delete this member?')">
                                                    <i class="fas fa-trash-alt"></i> Delete
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-5">
                            <div class="alert-custom">
                                <i class="fas fa-user-friends"></i>
                                <p>No members to display. Add your first member to get started!</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="text-center mt-4">
                <a href="@Url.Action("AddMember", "Gym")" class="btn btn-success-custom">
                    <i class="fas fa-user-plus me-2"></i> Add New Member
                </a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>