@using GymPL.ViewModel
@model EditVM  

@{
    ViewData["Title"] = "Edit Member";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Gym Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* Full page background with gym image */
        body {
            background: url('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?ixlib=rb-4.0.3&auto=format&fit=crop&w=1950&q=80') no-repeat center center fixed;
            background-size: cover;
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 0;
            position: relative;
        }

        /* Dark overlay for better readability */
        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.65);
            z-index: -1;
        }

        /* Card style */
        .edit-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 25px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
            border: none;
            overflow: hidden;
            transition: transform 0.3s ease;
        }

        .edit-card:hover {
            transform: translateY(-5px);
        }

        .card-header {
            background: linear-gradient(135deg, #ff6b6b, #ee5a24);
            color: white;
            text-align: center;
            padding: 1.5rem;
            border-bottom: none;
        }

        .card-header h2 {
            margin: 0;
            font-weight: 600;
            letter-spacing: 1px;
        }

        .card-header i {
            font-size: 2.5rem;
            margin-bottom: 10px;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        label {
            font-weight: 600;
            color: #333;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        label i {
            color: #ee5a24;
            width: 20px;
        }

        .form-control {
            border-radius: 12px;
            padding: 12px 15px;
            border: 1px solid #ddd;
            transition: all 0.3s;
            background: rgba(255, 255, 255, 0.9);
        }

        .form-control:focus {
            border-color: #ee5a24;
            box-shadow: 0 0 0 0.2rem rgba(238, 90, 36, 0.25);
        }

        .btn-update {
            background: linear-gradient(135deg, #ee5a24, #ff6b6b);
            border: none;
            border-radius: 50px;
            padding: 12px 30px;
            font-weight: bold;
            font-size: 1.1rem;
            transition: all 0.3s;
            width: 100%;
            color: white;
        }

        .btn-update:hover {
            transform: scale(1.02);
            box-shadow: 0 5px 15px rgba(238, 90, 36, 0.4);
            color: white;
        }

        .btn-back {
            background: #6c757d;
            border: none;
            border-radius: 50px;
            padding: 10px 20px;
            color: white;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: 0.3s;
        }

        .btn-back:hover {
            background: #5a6268;
            color: white;
        }

        .text-danger {
            font-size: 0.85rem;
            margin-top: 5px;
        }

        footer {
            text-align: center;
            margin-top: 30px;
            color: rgba(255, 255, 255, 0.7);
        }

          #All{
              margin:80px 0;
          }
    </style>
</head>
<body>

<div id="All" class="container  d-flex justify-content-center align-items-center min-vh-100">
    <div class="col-md-6 col-lg-5">
        <div class="edit-card">
            <div class="card-header">
                <i class="fas fa-user-edit"></i>
                <h2>Edit Member Profile</h2>
                <p class="mb-0">Update member information</p>
            </div>
            <div class="card-body p-4">
                    <form asp-action="EditMember" asp-controller="Gym" method="post">
                    @Html.AntiForgeryToken()
                    
                    <!-- Hidden field for Id (if you have it in EditVM) -->
                    <input type="hidden" asp-for="Id" />

                    <div class="form-group">
                        <label asp-for="Name"><i class="fas fa-user"></i> Full Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Enter full name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="PhoneNumber"><i class="fas fa-phone-alt"></i> Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Enter phone number" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="JoinDate"><i class="fas fa-calendar-alt"></i> Join Date</label>
                        <input asp-for="JoinDate" type="date" class="form-control" />
                        <span asp-validation-for="JoinDate" class="text-danger"></span>
                    </div>

                    @* <div class="form-group">
                        <label asp-for="TrainerName"><i class="fas fa-dumbbell"></i> Trainer Name</label>
                        <input asp-for="TrainerName" class="form-control" placeholder="Enter trainer name" />
                        <span asp-validation-for="TrainerName" class="text-danger"></span>
                    </div> *@

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn-update">
                            <i class="fas fa-save"></i> Update Member
                        </button>
                        <a asp-action="Index" asp-controller="Gym" class="btn-back text-center">
                            <i class="fas fa-arrow-left"></i> Back to Members List
                        </a>
                    </div>
                </form>
            </div>
        </div>
        <footer>
            <i class="fas fa-dumbbell"></i> Stay Strong | Gym Management System
        </footer>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>