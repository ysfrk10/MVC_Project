@using GymBL.DTOS
@using GymBL.DTOS.TrainerDTOS
@using GymDAL.Entities
@model IEnumerable<AddTrainerDTO>

@{
    ViewData["Title"] = "Our Expert Trainers";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Elite Gym</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
            :root {
                --bg-primary: #0a0a0a;
                --bg-secondary: #0f0f0f;
                --bg-card: #141414;
                --bg-elevated: #1a1a1a;
                --accent-primary: #e63946;
                --accent-secondary: #ff6b6b;
                --text-primary: #ffffff;
                --text-secondary: #b0b0b0;
                --text-muted: #6c757d;
                --border-color: #2a2a2a;
                --gradient-accent: linear-gradient(135deg, #e63946 0%, #ff6b6b 100%);
                --shadow-sm: 0 4px 20px rgba(0, 0, 0, 0.3);
                --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.4);
                --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--bg-primary);
                color: var(--text-primary);
                overflow-x: hidden;
                line-height: 1.5;
            }

            /* Custom Scrollbar */
            ::-webkit-scrollbar {
                width: 10px;
            }

            ::-webkit-scrollbar-track {
                background: var(--bg-secondary);
            }

            ::-webkit-scrollbar-thumb {
                background: var(--accent-primary);
                border-radius: 5px;
            }

            /* Navigation */
            .navbar {
                background: rgba(10, 10, 10, 0.95);
                backdrop-filter: blur(10px);
                padding: 1rem 0;
                transition: var(--transition);
                border-bottom: 1px solid var(--border-color);
            }

            .navbar-brand {
                font-size: 1.8rem;
                font-weight: 800;
                background: var(--gradient-accent);
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent !important;
                letter-spacing: -0.5px;
            }

            .nav-link {
                color: var(--text-secondary) !important;
                font-weight: 500;
                transition: var(--transition);
                margin: 0 0.5rem;
            }

                .nav-link:hover, .nav-link.active {
                    color: var(--accent-primary) !important;
                }

            /* Page Header */
            .page-header {
                background: linear-gradient(135deg, rgba(230, 57, 70, 0.15) 0%, rgba(255, 107, 107, 0.05) 100%);
                padding: 120px 0 60px;
                border-bottom: 1px solid var(--border-color);
            }

                .page-header h1 {
                    font-size: 3rem;
                    font-weight: 800;
                    margin-bottom: 15px;
                }

                .page-header .highlight {
                    color: var(--accent-primary);
                }

                .page-header p {
                    color: var(--text-secondary);
                    font-size: 1.1rem;
                    max-width: 600px;
                    margin: 0 auto;
                }

            /* Trainer Cards Section */
            .trainers-section {
                padding: 60px 0;
            }

            .trainer-card {
                background: var(--bg-card);
                border-radius: 20px;
                overflow: hidden;
                transition: var(--transition);
                border: 1px solid var(--border-color);
                margin-bottom: 30px;
                height: 100%;
            }

                .trainer-card:hover {
                    transform: translateY(-10px);
                    border-color: var(--accent-primary);
                    box-shadow: var(--shadow-md);
                }

            .trainer-image {
                position: relative;
                height: 300px;
                overflow: hidden;
            }

                .trainer-image img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    transition: transform 0.5s ease;
                }

            .trainer-card:hover .trainer-image img {
                transform: scale(1.1);
            }

            .trainer-overlay {
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
                padding: 20px;
                opacity: 0;
                transition: var(--transition);
            }

            .trainer-card:hover .trainer-overlay {
                opacity: 1;
            }

            .social-icons {
                display: flex;
                gap: 12px;
                justify-content: center;
            }

                .social-icons a {
                    width: 36px;
                    height: 36px;
                    background: var(--accent-primary);
                    border-radius: 50%;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    color: white;
                    transition: var(--transition);
                }

                    .social-icons a:hover {
                        transform: translateY(-3px);
                        background: var(--accent-secondary);
                    }

            .trainer-info {
                padding: 25px;
                text-align: center;
            }

                .trainer-info h3 {
                    font-size: 1.4rem;
                    font-weight: 700;
                    margin-bottom: 5px;
                }

            .trainer-role {
                color: var(--accent-primary);
                font-weight: 600;
                margin-bottom: 15px;
                font-size: 0.9rem;
            }

            .trainer-bio {
                color: var(--text-secondary);
                font-size: 0.9rem;
                line-height: 1.6;
                margin-bottom: 15px;
            }

            .trainer-stats {
                display: flex;
                justify-content: space-around;
                padding-top: 15px;
                border-top: 1px solid var(--border-color);
                margin-top: 10px;
            }

                .trainer-stats .stat {
                    text-align: center;
                }

                .trainer-stats .stat-value {
                    font-weight: 700;
                    color: var(--text-primary);
                }

                .trainer-stats .stat-label {
                    font-size: 0.7rem;
                    color: var(--text-muted);
                }

            /* Empty State */
            .empty-state {
                text-align: center;
                padding: 60px 20px;
                background: var(--bg-card);
                border-radius: 20px;
                border: 1px solid var(--border-color);
            }

                .empty-state i {
                    font-size: 4rem;
                    color: var(--accent-primary);
                    margin-bottom: 20px;
                }

                .empty-state h3 {
                    margin-bottom: 10px;
                }

                .empty-state p {
                    color: var(--text-secondary);
                }

            /* Button */
            .btn-primary-custom {
                background: var(--gradient-accent);
                color: white;
                padding: 12px 32px;
                border-radius: 50px;
                font-weight: 600;
                transition: var(--transition);
                border: none;
                display: inline-flex;
                align-items: center;
                gap: 10px;
            }

                .btn-primary-custom:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 25px rgba(230, 57, 70, 0.4);
                    color: white;
                }

            /* Footer */
            footer {
                background: var(--bg-primary);
                border-top: 1px solid var(--border-color);
                padding: 40px 0 20px;
            }

            .footer-content {
                text-align: center;
                color: var(--text-muted);
                font-size: 0.9rem;
            }

                .footer-content a {
                    color: var(--accent-primary);
                    text-decoration: none;
                }

            /* Responsive */
            @@media (max-width: 768px) {
                .page-header {
                    padding: 100px 0 40px;
                }

                    .page-header h1 {
                        font-size: 2rem;
                    }

                .trainer-image {
                    height: 250px;
                }
            }

            /* Animation */
            @@keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .trainer-card {
                animation: fadeInUp 0.5s ease backwards;
            }

                .trainer-card:nth-child(1) {
                    animation-delay: 0.1s;
                }

                .trainer-card:nth-child(2) {
                    animation-delay: 0.2s;
                }

                .trainer-card:nth-child(3) {
                    animation-delay: 0.3s;
                }

                .trainer-card:nth-child(4) {
                    animation-delay: 0.4s;
                }

                .trainer-card:nth-child(5) {
                    animation-delay: 0.5s;
                }

                .trainer-card:nth-child(6) {
                    animation-delay: 0.6s;
                }

            #profile_img{
                width: 200px;
                height:200px;
                margin: 5% 27%;
            }

    </style>
</head>
<body>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/">ELITE GYM</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#pricing">Pricing</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Gym")">Members</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Page Header -->
    <section class="page-header">
        <div class="container text-center">
            <h1>Meet Our <span class="highlight">Expert Trainers</span></h1>
            <p>World-class certified professionals dedicated to helping you achieve your fitness goals</p>
        </div>
    </section>

    <!-- Trainers Grid -->
    <section class="trainers-section">
        <div class="container">
            @if (Model != null && Model.Any())
            {
                <div class="row">
                    @foreach (var trainer in Model)
                    {
                        <div class="col-lg-4 col-md-6 mb-4">
                            <div class="trainer-card h-100">
                                <div class="trainer-image position-relative">
                                    <img id ="profile_img" src= "~/images/user.jpg" alt="@trainer.Name" class="img-fluid" />

                                    <!-- الأزرار تظهر عند المرور بالماوس -->
                                    <div class="action-buttons text-center m-3">
                                        <a href="javascript:void(0);"
                                           class="edit-trainer-link"
                                           data-id="@trainer.Id"
                                           data-name="@trainer.Name"
                                           data-imgpath="@trainer.ImgPath"
                                           data-bs-toggle="modal"
                                           data-bs-target="#editTrainerModal">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>

                                        <span class="separator">|</span>

                                        <a href="javascript:void(0);"
                                           class="delete-trainer-link text-danger"
                                           data-id="@trainer.Id"
                                           data-name="@trainer.Name"
                                           data-bs-toggle="modal"
                                           data-bs-target="#deleteTrainerModal">
                                            <i class="fas fa-trash"></i> Remove
                                        </a>
                                    </div>

                                </div>

                                <div class="trainer-info ">
                                    <h3>@trainer.Name</h3>     
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-chalkboard-user"></i>
                    <h3>No Trainers Available</h3>
                    <p>We're currently updating our trainer roster. Please check back soon!</p>
                    <a href="/" class="btn-primary-custom mt-3">
                        <i class="fas fa-arrow-left"></i> Back to Home
                    </a>
                </div>
            }
        </div>
    </section>

    <!-- Call to Action -->
    <section class="py-5">
        <div class="container text-center">
            <div class="p-5 rounded-4" style="background: linear-gradient(135deg, rgba(230,57,70,0.1) 0%, rgba(255,107,107,0.05) 100%); border: 1px solid var(--border-color);">
                <h3 class="mb-3">Ready to Start Your Journey?</h3>
                <p class="text-secondary mb-4">Book a session with one of our expert trainers today</p>
                <a href="@Url.Action("AddMember", "Gym")" class="btn-primary-custom">
                    <i class="fas fa-calendar-check"></i> Book a Session
                </a>
            </div>
        </div>
    </section>

 

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>