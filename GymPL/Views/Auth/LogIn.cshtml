@using GymPL.ViewModel.Auth
@model LoginUserVM

@{
    ViewData["Title"] = "Login - GymAwy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
 
        :root {
            --bg-primary: #0a0a0a;
            --bg-secondary: #0f0f0f;
            --bg-card: #141414;
            --bg-elevated: #1a1a1a;
            --accent-primary: #e63946;
            --accent-secondary: #ff6b6b;
            --text-primary: #ffffff;
            --text-secondary: #b0b0b0;
            --text-muted: #6c757d;
            --border-color: #2a2a2a;
            --gradient-accent: linear-gradient(135deg, #e63946 0%, #ff6b6b 100%);
            --shadow-sm: 0 4px 20px rgba(0, 0, 0, 0.3);
            --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.4);
            --shadow-lg: 0 15px 40px rgba(0, 0, 0, 0.5);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            background: var(--bg-primary);
            position: relative;
        }

            /* Animated Background */
            body::before {
                content: '';
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: radial-gradient(circle at 20% 50%, rgba(230, 57, 70, 0.08) 0%, transparent 50%), radial-gradient(circle at 80% 80%, rgba(255, 107, 107, 0.05) 0%, transparent 50%);
                z-index: -1;
            }

        /* Navigation */
        .navbar {
            background: rgba(10, 10, 10, 0.95);
            backdrop-filter: blur(10px);
            padding: 1rem 0;
            border-bottom: 1px solid var(--border-color);
        }

        .navbar-brand {
            font-size: 1.8rem;
            font-weight: 800;
            background: var(--gradient-accent);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent !important;
            letter-spacing: -0.5px;
        }

        .nav-link {
            color: var(--text-secondary) !important;
            font-weight: 500;
            transition: var(--transition);
            margin: 0 0.5rem;
        }

            .nav-link:hover {
                color: var(--accent-primary) !important;
            }

        /* Main Container */
        .auth-container {
            min-height: calc(100vh - 200px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
        }

        .auth-card {
            max-width: 480px;
            width: 100%;
            background: var(--bg-card);
            border-radius: 24px;
            box-shadow: var(--shadow-lg);
            overflow: hidden;
            border: 1px solid var(--border-color);
            animation: slideUp 0.5s ease;
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Card Header */
        .card-header {
            background: linear-gradient(135deg, rgba(230, 57, 70, 0.15) 0%, rgba(255, 107, 107, 0.05) 100%);
            padding: 30px;
            text-align: center;
            border-bottom: 1px solid var(--border-color);
        }

            .card-header .logo-icon {
                font-size: 48px;
                background: var(--gradient-accent);
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
                margin-bottom: 10px;
            }

            .card-header h2 {
                margin: 0;
                font-size: 1.8rem;
                font-weight: 700;
                color: var(--text-primary);
            }

            .card-header p {
                margin: 8px 0 0;
                color: var(--text-secondary);
                font-size: 0.9rem;
            }

        /* Toggle Switch */
        .toggle-container {
            background: var(--bg-elevated);
            padding: 8px;
            border-radius: 60px;
            margin: 20px 30px 0;
            border: 1px solid var(--border-color);
        }

        .toggle-switch {
            display: flex;
            gap: 8px;
        }

        .toggle-option {
            flex: 1;
            text-align: center;
            padding: 12px 20px;
            border-radius: 50px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            background: transparent;
            color: var(--text-secondary);
            border: none;
            font-size: 1rem;
        }

            .toggle-option i {
                margin-right: 8px;
            }

            .toggle-option.active {
                background: var(--gradient-accent);
                color: white;
                box-shadow: var(--shadow-sm);
            }

            .toggle-option:not(.active):hover {
                background: rgba(230, 57, 70, 0.1);
                color: var(--text-primary);
            }

        /* Card Body */
        .card-body {
            padding: 30px;
        }

        /* Form Groups */
        .form-group {
            margin-bottom: 22px;
        }

            .form-group label {
                font-weight: 600;
                color: var(--text-primary);
                margin-bottom: 8px;
                display: block;
                font-size: 0.9rem;
            }

                .form-group label i {
                    color: var(--accent-primary);
                    margin-right: 8px;
                }

        .required:after {
            content: '*';
            color: var(--accent-primary);
            margin-left: 4px;
        }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            background: var(--bg-elevated);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            font-size: 0.95rem;
            color: var(--text-primary);
            transition: var(--transition);
        }

            .form-control:focus {
                border-color: var(--accent-primary);
                outline: none;
                box-shadow: 0 0 0 3px rgba(230, 57, 70, 0.15);
                background: var(--bg-elevated);
                color: var(--text-primary);
            }

            .form-control::placeholder {
                color: var(--text-muted);
            }

        /* Password Toggle */
        .password-wrapper {
            position: relative;
        }

        .password-toggle {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: var(--text-muted);
            transition: var(--transition);
        }

            .password-toggle:hover {
                color: var(--accent-primary);
            }

        /* Validation */
        .text-danger {
            color: var(--accent-primary);
            font-size: 0.75rem;
            margin-top: 5px;
            display: block;
        }

        .validation-summary-errors {
            background: rgba(230, 57, 70, 0.15);
            border: 1px solid rgba(230, 57, 70, 0.3);
            border-radius: 12px;
            padding: 12px 16px;
            margin-bottom: 20px;
            color: var(--accent-primary);
        }

            .validation-summary-errors ul {
                margin: 0;
                padding-left: 20px;
            }

        /* Buttons */
        .btn-auth {
            width: 100%;
            padding: 14px;
            background: var(--gradient-accent);
            color: white;
            border: none;
            border-radius: 50px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            margin-top: 10px;
        }

            .btn-auth:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(230, 57, 70, 0.4);
            }

            .btn-auth:active {
                transform: translateY(0);
            }

        /* Footer Links */
        .auth-footer {
            text-align: center;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid var(--border-color);
        }

            .auth-footer p {
                color: var(--text-secondary);
                font-size: 0.85rem;
                margin: 0;
            }

            .auth-footer a {
                color: var(--accent-primary);
                text-decoration: none;
                font-weight: 500;
            }

                .auth-footer a:hover {
                    text-decoration: underline;
                }

        /* Forgot Password */
        .forgot-password {
            text-align: right;
            margin-top: -15px;
            margin-bottom: 20px;
        }

            .forgot-password a {
                color: var(--text-muted);
                font-size: 0.75rem;
                text-decoration: none;
                transition: var(--transition);
            }

                .forgot-password a:hover {
                    color: var(--accent-primary);
                }

        /* Social Login */
        .social-login {
            margin-top: 25px;
            text-align: center;
        }

            .social-login p {
                color: var(--text-muted);
                font-size: 0.8rem;
                margin-bottom: 15px;
                position: relative;
            }

                .social-login p::before,
                .social-login p::after {
                    content: '';
                    position: absolute;
                    top: 50%;
                    width: calc(50% - 40px);
                    height: 1px;
                    background: var(--border-color);
                }

                .social-login p::before {
                    left: 0;
                }

                .social-login p::after {
                    right: 0;
                }

        .social-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
        }

        .social-btn {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: var(--bg-elevated);
            border: 1px solid var(--border-color);
            color: var(--text-secondary);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
            cursor: pointer;
        }

            .social-btn:hover {
                border-color: var(--accent-primary);
                color: var(--accent-primary);
                transform: translateY(-2px);
            }

        /* Footer */
        footer {
            background: var(--bg-primary);
            border-top: 1px solid var(--border-color);
            padding: 30px 0 20px;
            margin-top: 60px;
        }

        .footer-content {
            text-align: center;
            color: var(--text-muted);
            font-size: 0.85rem;
        }

            .footer-content a {
                color: var(--accent-primary);
                text-decoration: none;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .auth-container {
                padding: 20px 16px;
            }

            .card-header {
                padding: 25px 20px;
            }

            .card-body {
                padding: 25px 20px;
            }

            .toggle-container {
                margin: 15px 20px 0;
            }

            .toggle-option {
                padding: 10px 16px;
                font-size: 0.9rem;
            }
        }

        /* Loading State */
        .btn-auth.loading {
            opacity: 0.7;
        }

        .auth-container {
            margin: 80px auto;
        }
        p{
            color:White;
        }
        h4{
            color:white;
        }
        .create-acc{
            color:var(--accent-primary) 
        }

</style>

<div class="auth-container">
    <div class="auth-card">
        <div class="card-header">
            <div class="logo-icon">
                <i class="fas fa-dumbbell"></i>
            </div>
            <h2>Welcome Back!</h2>
            <p>Sign in to continue your fitness journey 💪</p>
        </div>

        <div class="card-body">
            <form id="loginForm" asp-action="Login" asp-controller="Auth" method="post" style="display: block;">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="form-group">
                    <label asp-for="UserName">
                        <i class="fas fa-user"></i> Username or Email
                    </label>
                    <input asp-for="UserName" class="form-control" placeholder="Enter your username or email" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password">
                        <i class="fas fa-lock"></i> Password
                    </label>
                    <div class="password-wrapper">
                        <input asp-for="Password" id="loginPassword" class="form-control" placeholder="Enter your password" />
                        <i class="fas fa-eye password-toggle" onclick="togglePassword('loginPassword', this)"></i>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="forgot-password">
                    <a href="#"><i class="fas fa-key"></i> Forgot Password?</a>
                </div>

                <button type="submit" class="btn-auth">
                    <i class="fas fa-sign-in-alt"></i> Sign In
                </button>

                <div class="auth-footer">
                    <p>Don't have an account? <a asp-action="Register" asp-controller="Auth" class="create-acc">Create Account</a></p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function togglePassword(inputId, iconElement) {
        const input = document.getElementById(inputId);
        if (input.type === 'password') {
        input.type = 'text';
        iconElement.classList.remove('fa-eye');
        iconElement.classList.add('fa-eye-slash');
        } else {
        input.type = 'password';
        iconElement.classList.remove('fa-eye-slash');
        iconElement.classList.add('fa-eye');
        }
        }
    </script>
}